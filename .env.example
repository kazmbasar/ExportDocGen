# Copy to .env and fill in.  ->  cp .env.example .env

# Public hostname. A DNS A record for this name must point at the server's
# public IP. Caddy obtains the HTTPS certificate for exactly this name.
SITE_ADDRESS=exportdocgen.example.com

# The shared login password, as a PBKDF2 hash (never the plaintext).
# Generate it after the first build:
#   docker compose run --rm --no-deps -e Auth__PasswordHash=x app hash-password 'your-password'
# then paste the v1.... line here.
AUTH_PASSWORD_HASH=v1.210000.REPLACE_ME.REPLACE_ME

# Cosmetic — shown on the "Sign out" area.
AUTH_USERNAME=Team
