# Copy to .env and fill in.  ->  cp .env.example .env
# Read by docker-compose.yml. The public hostname is NOT here — it is set in the
# nginx site config (deploy/nginx/exportdocgen.conf) on the server.

# The shared login password, as a PBKDF2 hash (never the plaintext).
# Generate it after the first build:
#   docker compose build
#   docker compose run --rm --no-deps app hash-password 'your-password'
# then paste the v1.... line here.
AUTH_PASSWORD_HASH=v1.210000.REPLACE_ME.REPLACE_ME

# Cosmetic — shown near the "Sign out" button.
AUTH_USERNAME=Team
