@page "/orders/new"
@page "/orders/{Id:int}"
@inject OrderService OrderService
@inject CustomerService CustomerService
@inject ProductService ProductService
@inject SellerCompanyService SellerCompanyService
@inject CalculationService Calc
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "New order" : _order.OrderNumber)</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">@(IsNew ? "New order" : $"Order {_order.OrderNumber}")</MudText>
        <MudSpacer />
        @if (!IsNew)
        {
            <MudButton StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       Href="@($"/orders/{Id}/proforma.pdf")" Target="_blank">
                Proforma PDF
            </MudButton>
        }
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_saving">
            Save
        </MudButton>
    </MudStack>

    <MudForm @ref="_form" Model="_order">
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="int" Label="Seller company" Value="_order.SellerCompanyId"
                           ValueChanged="OnSellerChanged" Required="true"
                           RequiredError="Choose the company issuing this order">
                    @foreach (var s in _sellers)
                    {
                        <MudSelectItem T="int" Value="s.Id">@s.ShortName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="int" Label="Customer" Value="_order.CustomerId"
                           ValueChanged="OnCustomerChanged" Required="true"
                           RequiredError="Choose a customer">
                    @foreach (var c in _customers)
                    {
                        <MudSelectItem T="int" Value="c.Id">@c.Name (@c.Country)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudDatePicker Label="Order date" Date="_orderDate" DateChanged="d => _orderDate = d" />
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudTextField @bind-Value="_order.Currency" Label="Currency" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_order.Incoterm" Label="Incoterm" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_order.PaymentTerms" Label="Payment terms" />
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudTextField @bind-Value="_order.DeliveryTime" Label="Delivery time" />
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudTextField @bind-Value="_order.Validity" Label="Validity" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_order.BankDetails" Label="Bank details" Lines="6"
                              HelperText="Printed verbatim on the proforma" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_order.Notes" Label="Notes" Lines="2" />
            </MudItem>
        </MudGrid>
    </MudForm>

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-6 mb-2">
        <MudText Typo="Typo.h6">Lines</MudText>
        <MudSpacer />
        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">
            Add line
        </MudButton>
    </MudStack>

    <MudSimpleTable Dense="true" Hover="true" Style="overflow-x:auto">
        <thead>
            <tr>
                <th style="width:34%">Product</th>
                <th style="width:12%">Quantity</th>
                <th style="width:16%">Unit price</th>
                <th style="width:10%" class="text-right">Cartons</th>
                <th style="width:14%" class="text-right">Net kg</th>
                <th style="width:14%" class="text-right">Line total</th>
                <th style="width:5%"></th>
            </tr>
        </thead>
        <tbody>
            @if (_order.Lines.Count == 0)
            {
                <tr><td colspan="7"><MudText Typo="Typo.body2">No lines yet.</MudText></td></tr>
            }
            @foreach (var line in _order.Lines)
            {
                var calc = LineCalc(line);
                <tr @key="line">
                    <td>
                        <MudSelect T="int" Value="line.ProductId" Dense="true"
                                   ValueChanged="v => OnLineProductChanged(line, v)">
                            @foreach (var p in _products)
                            {
                                <MudSelectItem T="int" Value="p.Id">@p.PartNumber — @p.Description</MudSelectItem>
                            }
                        </MudSelect>
                    </td>
                    <td>
                        <MudNumericField T="int" @bind-Value="line.Quantity" Min="1" Margin="Margin.Dense" />
                    </td>
                    <td>
                        <MudNumericField T="decimal" @bind-Value="line.UnitPrice" Min="0" Format="0.00" Margin="Margin.Dense" />
                    </td>
                    <td class="text-right">@(calc?.Cartons.ToString() ?? "–")</td>
                    <td class="text-right">@(calc?.NetWeightKg.ToString("0.###") ?? "–")</td>
                    <td class="text-right">@(calc?.LineTotal.ToString("N2") ?? "–")</td>
                    <td>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => _order.Lines.Remove(line))" />
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    <MudGrid Class="mt-4">
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudText Typo="Typo.overline">Order total</MudText>
                <MudText Typo="Typo.h6">@Calculation.OrderTotal.ToString("N2") @_order.Currency</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudText Typo="Typo.overline">Net weight</MudText>
                <MudText Typo="Typo.h6">@Calculation.TotalNetWeightKg.ToString("0.###") kg</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudText Typo="Typo.overline">Gross weight</MudText>
                <MudText Typo="Typo.h6">@Calculation.TotalGrossWeightKg.ToString("0.###") kg</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudText Typo="Typo.overline">Cartons</MudText>
                <MudText Typo="Typo.h6">@Calculation.TotalCartons</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudText Typo="Typo.overline">Volume (CBM)</MudText>
                <MudText Typo="Typo.h6">@Calculation.TotalVolumeM3.ToString("0.###")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.caption" Class="mt-2">
        Gross weight includes empty-carton weight. Cartons round up to whole
        cartons per line. Volume is outer-carton CBM.
    </MudText>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;

    private Order _order = new();
    private DateTime? _orderDate = DateTime.Today;
    private List<Customer> _customers = [];
    private List<SellerCompany> _sellers = [];
    private List<Product> _products = [];
    private Dictionary<int, Product> _productLookup = [];
    private MudForm _form = default!;
    private bool _loading = true;
    private bool _saving;

    private Product? ProductFor(int productId) =>
        _productLookup.TryGetValue(productId, out var p) ? p : null;

    private LineCalculation? LineCalc(OrderLine line)
    {
        var product = ProductFor(line.ProductId);
        return product is null ? null : Calc.CalculateLine(line.Quantity, line.UnitPrice, product);
    }

    private OrderCalculation Calculation => Calc.CalculateOrder(
        _order.Lines
            .Select(l => (l.Quantity, l.UnitPrice, Product: ProductFor(l.ProductId)))
            .Where(t => t.Product is not null)
            .Select(t => (t.Quantity, t.UnitPrice, t.Product!)));

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _customers = await CustomerService.GetAllAsync();
        _sellers = await SellerCompanyService.GetAllAsync();
        _products = await ProductService.GetAllAsync(includeInactive: false);
        _productLookup = _products.ToDictionary(p => p.Id);

        if (IsNew)
        {
            _order = new Order { Currency = "USD" };
            _orderDate = DateTime.Today;
            if (_sellers.Count > 0)
                OnSellerChanged(_sellers[0].Id);
        }
        else
        {
            var loaded = await OrderService.GetAsync(Id!.Value);
            if (loaded is null)
            {
                Snackbar.Add("Order not found.", Severity.Error);
                Nav.NavigateTo("/orders");
                return;
            }
            _order = loaded;
            _orderDate = _order.OrderDate.ToDateTime(TimeOnly.MinValue);

            // Include products that are on the order but no longer in the active catalog.
            foreach (var line in _order.Lines.Where(l => l.Product is not null))
                _productLookup.TryAdd(line.Product!.Id, line.Product!);
        }
        _loading = false;
    }

    private void OnCustomerChanged(int customerId)
    {
        _order.CustomerId = customerId;
        var customer = _customers.FirstOrDefault(c => c.Id == customerId);
        if (customer is not null)
        {
            if (string.IsNullOrWhiteSpace(_order.Incoterm))
                _order.Incoterm = customer.DefaultIncoterm ?? "";
            if (IsNew || string.IsNullOrWhiteSpace(_order.Currency))
                _order.Currency = customer.DefaultCurrency;
            if (string.IsNullOrWhiteSpace(_order.PaymentTerms))
                _order.PaymentTerms = PaymentTermText.Of(customer.PaymentType);
        }
    }

    private void OnSellerChanged(int sellerId)
    {
        _order.SellerCompanyId = sellerId;
        var seller = _sellers.FirstOrDefault(s => s.Id == sellerId);
        if (seller is null) return;

        if (string.IsNullOrWhiteSpace(_order.BankDetails))
            _order.BankDetails = seller.DefaultBankDetails;
        if (string.IsNullOrWhiteSpace(_order.DeliveryTime))
            _order.DeliveryTime = seller.DefaultDeliveryTime;
        if (string.IsNullOrWhiteSpace(_order.Validity))
            _order.Validity = seller.DefaultValidity;
    }

    private void AddLine()
    {
        var firstProduct = _products.FirstOrDefault();
        _order.Lines.Add(new OrderLine
        {
            ProductId = firstProduct?.Id ?? 0,
            Quantity = 1,
            UnitPrice = firstProduct?.DefaultUnitPrice ?? 0m,
        });
    }

    private void OnLineProductChanged(OrderLine line, int productId)
    {
        line.ProductId = productId;
        var product = _products.FirstOrDefault(p => p.Id == productId);
        if (product?.DefaultUnitPrice is { } price && line.UnitPrice == 0m)
            line.UnitPrice = price;
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;
        if (_order.SellerCompanyId == 0)
        {
            Snackbar.Add("Choose a seller company.", Severity.Error);
            return;
        }
        if (_order.CustomerId == 0)
        {
            Snackbar.Add("Choose a customer.", Severity.Error);
            return;
        }
        if (_order.Lines.Count == 0)
        {
            Snackbar.Add("Add at least one line.", Severity.Error);
            return;
        }
        if (_order.Lines.Any(l => l.ProductId == 0))
        {
            Snackbar.Add("Every line needs a product.", Severity.Error);
            return;
        }

        _order.OrderDate = DateOnly.FromDateTime(_orderDate ?? DateTime.Today);
        _order.Currency = _order.Currency.Trim().ToUpperInvariant();

        _saving = true;
        try
        {
            if (IsNew)
            {
                var newId = await OrderService.CreateAsync(_order);
                Snackbar.Add("Order created.", Severity.Success);
                Nav.NavigateTo($"/orders/{newId}");
            }
            else
            {
                await OrderService.UpdateAsync(_order);
                Snackbar.Add("Order saved.", Severity.Success);
                Nav.NavigateTo("/orders");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
            _saving = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/orders");
}
